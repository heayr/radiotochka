# База данных PostgreSQL (Prisma & Docker Compose)
POSTGRES_USER="radiotochka"
POSTGRES_PASSWORD="generate-strong-db-password-here"
POSTGRES_DB="radiotochka"
DATABASE_URL="postgresql://radiotochka:generate-strong-db-password-here@localhost:5432/radiotochka?schema=public"

# Auth.js / NextAuth v5
# Сгенерируйте секретный ключ, например: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-chars"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Первоначальный администратор (для prisma db seed)
INITIAL_ADMIN_EMAIL="admin@radiotochka.ru"
INITIAL_ADMIN_PASSWORD="generate-strong-admin-password"

# Resend (отправка системных email и кодов 2FA)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="noreply@radiotochka.ru"

# Публичный URL приложения (для ссылок в письмах и редиректов)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web3Forms (форма обратной связи в футере / на сайте)
NEXT_PUBLIC_ACCESS_KEY_WEB_FORM="your-web3forms-access-key"