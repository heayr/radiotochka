{
  "name": "balakovo-fm",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "docs:dev": "cognidocs dev",
    "docs:build": "cognidocs build --static-export",
    "docs:introspect": "node -e \"require('fs').mkdirSync('docs/architecture', {recursive:true}); console.log('Run: npx next-introspect scan --output docs/architecture/routing.json')\"",
    "docs:openapi": "node -e \"require('fs').mkdirSync('docs/api', {recursive:true}); console.log('Run: npx nextjs-auto-swagger generate --output docs/api/openapi.yaml')\"",
    "docs:onboard": "node -e \"require('fs').mkdirSync('docs/diagrams', {recursive:true}); console.log('Run: npx dev-onboarder generate')\"",
    "docs:all": "npm run docs:introspect && npm run docs:openapi && npm run docs:build",
    "docs:er": "npx prisma-erd --output docs/diagrams/er.mmd"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "next": "15.2.0",
    "next-auth": "5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "resend": "^4.0.0",
    "speakeasy": "^2.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/speakeasy": "^2.0.10",
    "autoprefixer": "^10.0.1",
    "cognidocs": "^0.0.2",
    "eslint": "^8",
    "eslint-config-next": "15.2.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
